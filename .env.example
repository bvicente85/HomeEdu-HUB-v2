# GEMINI_API_KEY: Required for Gemini AI API calls (future phases).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Phase 1):
# Connect to your private Supabase project.
# The browser client MUST only use the public publishable key with Row Level Security (RLS).
# Never use or expose secret or service-role keys in browser variables.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

